# Drox Trade Post — environment template.
# Copy to .env and fill in. Never commit .env with real secrets.

# --- Trading mode ---
TRADING_MODE=paper
EXCHANGE_ID=kraken
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
ENABLE_SANDBOX=true

# --- Ollama (cloud or local) ---
# Set to your Ollama endpoint — http://localhost:11434 for local, or your cloud URL
OLLAMA_URL=http://localhost:11434
# API key required for Ollama Cloud; leave empty for local
OLLAMA_API_KEY=
OLLAMA_MODEL=minimax-m3:cloud

# --- Risk limits ---
MAX_POSITION_PCT=2.0
MAX_DAILY_LOSS_PCT=1.0
POSITION_SIZE_HARD_CAP=1000.0
SLIPPAGE_BPS=5.0
ORPHAN_AGE_THRESHOLD_SEC=300

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./trade_post.db

# --- Server ---
PORT=8065
HOST=0.0.0.0
APP_ENV=development

# --- Bootstrap admin ---
# Password for the seeded admin user. If unset and no admin exists at startup,
# a one-time random password is generated and logged once at WARNING level.
# Do not rely on a default value in production.
DROX_ADMIN_PASSWORD=

# --- Auth ---
SESSION_SECRET=change-me-to-a-32-character-or-longer-random-string
SESSION_TTL_MINUTES=480
BCRYPT_WORK_FACTOR=12
